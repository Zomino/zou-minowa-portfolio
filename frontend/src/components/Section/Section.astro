---
import type { HTMLAttributes } from "astro/types";

import type { Props as HeadingProps } from "../Heading/Heading.astro";
import Heading from "../Heading/Heading.astro";

interface Props extends HTMLAttributes<"section"> {
  heading: string;
  headingLevel?: HeadingProps["level"];
  headingVariant?: HeadingProps["variant"];
}

const {
  heading,
  headingLevel = 2,
  headingVariant = headingLevel,
  class: className,
  ...rest
} = Astro.props;
---

<section class={className} {...rest}>
  <Heading level={headingLevel} variant={headingVariant} spacing>
    {heading}
  </Heading>
  <slot />
</section>
