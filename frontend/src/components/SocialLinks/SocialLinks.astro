---
import clsx from "clsx";
import IconLink from "../IconLink/IconLink.astro";
import metadata from "../../../metadata.json";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const classes = clsx("flex items-center justify-center gap-4", className);
---

<div class={classes}>
  <IconLink href={metadata.github} icon="github" ariaLabel="GitHub" />
  <IconLink href={metadata.linkedin} icon="linkedin" ariaLabel="LinkedIn" />
  <IconLink
    href={`mailto:${metadata.email}`}
    icon="mail"
    ariaLabel="Email"
    openNewTab={false}
  />
</div>
