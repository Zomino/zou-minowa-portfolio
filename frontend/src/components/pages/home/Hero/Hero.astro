---
import Heading from "../../../common/Heading/Heading.astro";
import SocialLinks from "../../../common/SocialLinks/SocialLinks.astro";
import Text from "../../../common/Text/Text.astro";
import metadata from "../../../../metadata.json";

const nameLines = metadata.siteTitle.split(" ");
---

<section class="lg:shrink-0">
  <Text variant="eyebrow">Fullstack software engineer</Text>
  <div data-brand-target>
    <Heading level={1} class="text-6xl md:text-7xl">
      {nameLines.map((line) => <span class="block">{line}</span>)}
    </Heading>
  </div>
  <Text class="mt-6">London-based. Generalist. AI pilled.</Text>
  <SocialLinks class="mt-6 justify-start" />
</section>
