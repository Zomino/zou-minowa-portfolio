---
import { getCollection } from "astro:content";

import Badge from "../../../common/Badge/Badge.astro";
import BadgeGroup from "../../../common/BadgeGroup/BadgeGroup.astro";
import Heading from "../../../common/Heading/Heading.astro";

const getTopTags = (tagLists: string[][], limit: number): string[] => {
  const tagCounts = new Map<string, number>();

  for (const tags of tagLists) {
    for (const tag of tags) {
      tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
    }
  }

  return [...tagCounts.entries()]
    .sort(([, a], [, b]) => b - a)
    .slice(0, limit)
    .map(([tag]) => tag);
};

const CORE_SKILLS = [
  "TypeScript",
  "React",
  "Node",
  "MongoDB",
  "Agentic coding",
  "AWS",
  "Terraform",
  "Accessibility",
  "Docker",
  "CI/CD",
];

const MAX_EXTENDED_SKILLS = 4;

const projects = await getCollection("projects");
const extendedSkills = getTopTags(
  projects.map((project) => project.data.tech),
  MAX_EXTENDED_SKILLS,
);
---

<section>
  <Heading level={2} class="sr-only">Core skills</Heading>
  <BadgeGroup>
    {CORE_SKILLS.map((skill) => <Badge>{skill}</Badge>)}
    {
      extendedSkills.map((skill) => (
        <Badge class="hidden lg:block">{skill}</Badge>
      ))
    }
  </BadgeGroup>
</section>
