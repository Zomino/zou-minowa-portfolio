---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div data-tag-filter-panel class="mt-3 flex hidden flex-wrap gap-2">
  <button
    data-tag-filter-tag="all"
    class="rounded-full border border-slate-900 bg-slate-900 px-4 py-2 text-xs text-white shadow-sm transition-colors"
  >
    All
  </button>
  {
    tags.map((tag) => (
      <button
        data-tag-filter-tag={tag}
        class="rounded-full border border-slate-200 bg-white/90 px-4 py-2 text-xs text-slate-600 shadow-sm transition-colors hover:border-slate-400"
      >
        {tag}
      </button>
    ))
  }
</div>

<script>
  const panel = document.querySelector<HTMLElement>("[data-tag-filter-panel]");
  const tagButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-tag-filter-tag]",
  );

  const activeTags = new Set<string>();

  function updateUI() {
    tagButtons.forEach((btn) => {
      const tag = btn.dataset.tagFilterTag ?? "all";
      const isActive =
        tag === "all" ? activeTags.size === 0 : activeTags.has(tag);
      btn.classList.toggle("bg-slate-900", isActive);
      btn.classList.toggle("text-white", isActive);
      btn.classList.toggle("border-slate-900", isActive);
      btn.classList.toggle("bg-white/90", !isActive);
      btn.classList.toggle("text-slate-600", !isActive);
      btn.classList.toggle("border-slate-200", !isActive);
    });
  }

  tagButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tag = btn.dataset.tagFilterTag ?? "all";
      if (tag === "all") {
        activeTags.clear();
      } else if (activeTags.has(tag)) {
        activeTags.delete(tag);
      } else {
        activeTags.add(tag);
      }
      updateUI();
      document.dispatchEvent(
        new CustomEvent("tagfilter:change", {
          bubbles: true,
          detail: { tags: [...activeTags] },
        }),
      );
    });
  });

  document.addEventListener("tagfilter:toggle", () => {
    panel?.classList.toggle("hidden");
  });
</script>
