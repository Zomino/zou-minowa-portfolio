---
import { getCollection } from "astro:content";

import JournalSummary from "../../components/JournalSummary/JournalSummary.astro";
import ListPage from "../../components/ListPage/ListPage.astro";
import ListPageItem from "../../components/ListPage/components/ListPageItem/ListPageItem.astro";

const TITLE = "Journal";
const DESCRIPTION = "Things I have written.";
const WORDMARK = "雑記";

const entries = (await getCollection("journal")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const allTags = [...new Set(entries.flatMap((e) => e.data.tags))].sort();
---

<ListPage
  pageTitle={TITLE}
  description={DESCRIPTION}
  wordmark={WORDMARK}
  heading={TITLE}
  tags={allTags}
>
  <div class="mt-8 flex flex-col divide-y divide-slate-200">
    {
      entries.map((entry) => (
        <ListPageItem tags={entry.data.tags} class="py-8 first:pt-0 last:pb-0">
          <JournalSummary
            title={entry.data.title}
            description={entry.data.description}
            date={entry.data.date}
            tags={entry.data.tags}
            slug={entry.id}
            headingVariant={4}
          />
        </ListPageItem>
      ))
    }
  </div>
</ListPage>
