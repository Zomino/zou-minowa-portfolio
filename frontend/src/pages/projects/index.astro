---
import { getCollection } from "astro:content";
import ProjectSummary from "../../components/ProjectSummary/ProjectSummary.astro";
import ListPage from "../../components/ListPage/ListPage.astro";
import ListPageItem from "../../components/ListPage/components/ListPageItem/ListPageItem.astro";

const TITLE = "Projects";
const DESCRIPTION = "Software projects I have built.";
const WORDMARK = "プロジェクト";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
---

<ListPage
  pageTitle={TITLE}
  description={DESCRIPTION}
  wordmark={WORDMARK}
  heading={TITLE}
  tags={allTags}
>
  <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-3">
    {
      projects.map((project) => (
        <ListPageItem tags={project.data.tags}>
          <ProjectSummary
            title={project.data.title}
            description={project.data.description}
            link={project.data.link}
            github={project.data.github}
            image={project.data.image}
            tags={project.data.tags}
            type={project.data.type}
            slug={project.id}
            headingVariant={4}
          />
        </ListPageItem>
      ))
    }
  </div>
</ListPage>
