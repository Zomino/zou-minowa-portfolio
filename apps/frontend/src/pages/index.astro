---
import Layout from "../components/Layout/Layout.astro";
import NavBar from "../components/NavBar/NavBar.astro";
import AnimatedBrandLink from "./_home/AnimatedBrandLink/AnimatedBrandLink.astro";
import FeaturedProjectsSection from "./_home/FeaturedProjectsSection/FeaturedProjectsSection.astro";
import Hero from "./_home/Hero/Hero.astro";
import Reveal from "../components/Reveal/Reveal.astro";
import SkillsSection from "./_home/SkillsSection/SkillsSection.astro";
import metadata from "@/metadata.json";
---

<Layout pageTitle="Homepage">
  <NavBar slot="navbar">
    <AnimatedBrandLink
      href="#"
      animationStartTargetSelector="[data-brand-target]"
    >
      {metadata.siteTitle}
    </AnimatedBrandLink>
  </NavBar>
  <div
    class="flex flex-col gap-14 lg:flex-row lg:items-center lg:justify-between lg:gap-12"
  >
    <Hero />
    <Reveal>
      <SkillsSection />
    </Reveal>
  </div>
  <div class="mt-14">
    <FeaturedProjectsSection />
  </div>
</Layout>
