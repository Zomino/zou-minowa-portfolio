---
import { getCollection } from "astro:content";

import Heading from "../../../components/Heading/Heading.astro";
import ProjectSummary from "../../../components/ProjectSummary/ProjectSummary.astro";
import Reveal from "../../../components/Reveal/Reveal.astro";
import Section from "../../../components/Section/Section.astro";
const MAX_FEATURED = 3;

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, MAX_FEATURED);
---

<Section>
  <Reveal slot="heading">
    <Heading level={2} spacing>Featured projects</Heading>
  </Reveal>
  <div class="mt-9 grid grid-cols-1 gap-10 lg:grid-cols-3">
    {
      projects.map((project) => (
        <Reveal class="h-full">
          <ProjectSummary
            title={project.data.title}
            description={project.data.description}
            link={project.data.link}
            github={project.data.github}
            image={project.data.image}
            tags={project.data.tags}
            type={project.data.type}
            slug={project.id}
            headingVariant={4}
          />
        </Reveal>
      ))
    }
  </div>
</Section>
