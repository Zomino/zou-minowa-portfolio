{
  "name": "zou-minowa-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -F frontend build",
    "test": "pnpm -r exec vitest run",
    "check": "pnpm -r check",
    "lint": "pnpm -r lint",
    "prepare": "git config core.hooksPath .husky && husky install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2"
  }
}
