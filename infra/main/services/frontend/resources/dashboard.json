{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/RUM", "WebVitalsLargestContentfulPaint", "application_name", "${project_name}", { "label": "LCP p75" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "period": 3600,
        "stat": "p75",
        "title": "LCP p75 (ms)  ▸ good ≤ 2500, poor > 4000",
        "yAxis": {
          "left": { "min": 0, "max": 6000 }
        },
        "annotations": {
          "horizontal": [
            [
              { "label": "Good", "value": 0, "color": "#2ca02c" },
              { "value": 2500 }
            ],
            [
              { "label": "Needs improvement", "value": 2500, "color": "#ff9900" },
              { "value": 4000 }
            ],
            [
              { "label": "Poor", "value": 4000, "color": "#d62728" },
              { "value": 6000 }
            ]
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 0,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/RUM", "WebVitalsInteractionToNextPaint", "application_name", "${project_name}", { "label": "INP p75" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "period": 3600,
        "stat": "p75",
        "title": "INP p75 (ms)  ▸ good ≤ 200, poor > 500",
        "yAxis": {
          "left": { "min": 0, "max": 700 }
        },
        "annotations": {
          "horizontal": [
            [
              { "label": "Good", "value": 0, "color": "#2ca02c" },
              { "value": 200 }
            ],
            [
              { "label": "Needs improvement", "value": 200, "color": "#ff9900" },
              { "value": 500 }
            ],
            [
              { "label": "Poor", "value": 500, "color": "#d62728" },
              { "value": 700 }
            ]
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 0,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/RUM", "WebVitalsCumulativeLayoutShift", "application_name", "${project_name}"]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "stat": "p75",
        "period": 3600,
        "title": "Cumulative Layout Shift  ▸ good ≤ 0.1, poor > 0.25",
        "yAxis": {
          "left": { "min": 0, "max": 0.5 }
        },
        "annotations": {
          "horizontal": [
            [
              { "label": "Good", "value": 0, "color": "#2ca02c" },
              { "value": 0.1 }
            ],
            [
              { "label": "Needs improvement", "value": 0.1, "color": "#ff9900" },
              { "value": 0.25 }
            ],
            [
              { "label": "Poor", "value": 0.25, "color": "#d62728" },
              { "value": 0.5 }
            ]
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/CloudFront", "Requests", "Region", "Global", "DistributionId", "${distribution_id}"]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Sum",
        "period": 3600,
        "title": "CloudFront requests"
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/CloudFront", "4xxErrorRate", "Region", "Global", "DistributionId", "${distribution_id}"],
          [".", "5xxErrorRate", ".", ".", ".", "."]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 3600,
        "stat": "Average",
        "title": "CloudFront error rate %"
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 6,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/RUM", "JsErrorCount", "application_name", "${project_name}"]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "stat": "Sum",
        "period": 3600,
        "title": "Client JS errors  ▸ good 0, poor > 5",
        "yAxis": {
          "left": { "min": 0 }
        },
        "annotations": {
          "horizontal": [
            [
              { "label": "Good", "value": 0, "color": "#2ca02c" },
              { "value": 1 }
            ],
            [
              { "label": "Needs improvement", "value": 1, "color": "#ff9900" },
              { "value": 5 }
            ],
            [
              { "label": "Poor", "value": 5, "color": "#d62728" },
              { "value": 50 }
            ]
          ]
        }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 12,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/RUM", "SessionCount", "application_name", "${project_name}"],
          [".", "PageViewCount", ".", "."]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "stat": "Sum",
        "period": 3600,
        "title": "Traffic: sessions and page views"
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 12,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/Firehose", "DeliveryToS3.Success", "DeliveryStreamName", "${project_name}-rum-archive", { "label": "Delivery success" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "stat": "Average",
        "period": 3600,
        "title": "RUM log archive: Firehose delivery success"
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 12,
      "width": 8,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/Firehose", "IncomingRecords", "DeliveryStreamName", "${project_name}-rum-archive", { "label": "In" }],
          ["AWS/Firehose", "DeliveryToS3.Records", "DeliveryStreamName", "${project_name}-rum-archive", { "label": "Delivered to S3" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "stat": "Sum",
        "period": 3600,
        "title": "RUM log archive: records in and delivered"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 18,
      "width": 24,
      "height": 6,
      "properties": {
        "query": "SOURCE '/cloudfront/${project_name}/access-logs' | fields @timestamp, `sc-status`, `cs-uri-stem`, `c-ip`, `cs(User-Agent)` | filter `sc-status` >= 400 | sort @timestamp desc | limit 50",
        "region": "us-east-1",
        "stacked": false,
        "view": "table",
        "title": "CloudFront recent 4xx and 5xx requests"
      }
    }
  ]
}
