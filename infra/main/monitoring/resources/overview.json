{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/CloudFront", "Requests", "Region", "Global", "DistributionId", "${distribution_id}"]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Sum",
        "period": 3600,
        "title": "CloudFront requests"
      }
    },
    {
      "type": "metric",
      "x": 6,
      "y": 0,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/CloudFront", "4xxErrorRate", "Region", "Global", "DistributionId", "${distribution_id}"],
          [".", "5xxErrorRate", ".", ".", ".", "."]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "period": 3600,
        "stat": "Average",
        "title": "CloudFront error rate %"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/RUM", "SessionCount", "application_name", "${project_name}"],
          [".", "PageViewCount", ".", "."]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "stat": "Sum",
        "period": 3600,
        "title": "Traffic: sessions   and page views"
      }
    },
    {
      "type": "metric",
      "x": 18,
      "y": 0,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/RUM", "WebVitalsLargestContentfulPaint", "application_name", "${project_name}", { "label": "LCP p75" }],
          [".", "WebVitalsInteractionToNextPaint", ".", ".", { "label": "INP p75" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "period": 3600,
        "stat": "Average",
        "title": "Core Web Vitals (LCP, INP) ms"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/RUM", "WebVitalsCumulativeLayoutShift", "application_name", "${project_name}"]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "stat": "p75",
        "period": 3600,
        "title": "Cumulative Layout Shift"
      }
    },
    {
      "type": "metric",
      "x": 6,
      "y": 6,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/RUM", "JsErrorCount", "application_name", "${project_name}"]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "stat": "Sum",
        "period": 3600,
        "title": "Client JS errors"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/Firehose", "DeliveryToS3.Success", "DeliveryStreamName", "${project_name}-rum-archive", { "label": "Delivery success" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "stat": "Average",
        "period": 3600,
        "title": "RUM log archive: Firehose delivery success"
      }
    },
    {
      "type": "metric",
      "x": 18,
      "y": 6,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/Firehose", "IncomingRecords", "DeliveryStreamName", "${project_name}-rum-archive", { "label": "In" }],
          ["AWS/Firehose", "DeliveryToS3.Records", "DeliveryStreamName", "${project_name}-rum-archive", { "label": "Delivered to S3" }]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "stat": "Sum",
        "period": 3600,
        "title": "RUM log archive: records in and delivered"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 12,
      "width": 24,
      "height": 6,
      "properties": {
        "query": "SOURCE '/cloudfront/${project_name}/access-logs' | fields @timestamp, `sc-status`, `cs-uri-stem`, `c-ip`, `cs(User-Agent)` | filter `sc-status` >= 400 | sort @timestamp desc | limit 50",
        "region": "us-east-1",
        "stacked": false,
        "view": "table",
        "title": "CloudFront recent 4xx and 5xx requests"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 18,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          [ { "expression": "SEARCH('{ZouChat,Outcome} MetricName=\"Requests\"', 'Sum', 300)", "label": "Requests", "id": "e1" } ]
        ],
        "view": "timeSeries",
        "stacked": true,
        "region": "eu-west-2",
        "period": 300,
        "stat": "Sum",
        "title": "Chat requests by outcome"
      }
    },
    {
      "type": "metric",
      "x": 6,
      "y": 18,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          [ { "expression": "SEARCH('{ZouChat,Outcome} MetricName=\"Latency\"', 'Average', 300)", "label": "Latency avg", "id": "e2" } ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "period": 300,
        "stat": "Average",
        "title": "Chat latency ms"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 18,
      "width": 6,
      "height": 6,
      "properties": {
        "metrics": [
          ["AWS/Lambda", "Invocations", "FunctionName", "${project_name}-chat"],
          [".", "Errors", ".", "."],
          [".", "Throttles", ".", "."]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "eu-west-2",
        "period": 300,
        "stat": "Sum",
        "title": "Chat Lambda: invocations / errors / throttles"
      }
    }
  ]
}
